{
  "expo": {
    "name": "Inner Circle",
    "slug": "friendz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "friendz",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBFAF7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.friendz.app"
    },
    "android": {
      "package": "com.friendz.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Inner Circle uses Face ID to protect the secrets you store about people."
        }
      ],
      "expo-localization",
      [
        "expo-calendar",
        {
          "calendarPermission": "Inner Circle adds birthdays you choose to your calendar.",
          "remindersPermission": "Inner Circle adds birthday reminders you choose to your reminders."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Inner Circle reads your contacts so you can import the people you know, with their names, phone numbers, emails, birthdays and photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Inner Circle uses your photo library so you can pick profile photos for the people you save.",
          "cameraPermission": "Inner Circle uses the camera so you can take profile photos of the people you save.",
          "microphonePermission": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "friend-z",
          "organization": "szymon-k"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fdef4f42-54da-4660-942c-f46428d8ecf9"
      }
    },
    "owner": "szymonk92"
  }
}
